#!/usr/bin/env bash
# Format/lint staged files before they land. Keeps blame and diffs clean.
#
# Escape hatches:
#   - Skip once:  git commit --no-verify
#   - Disable:    git config --unset core.hookspath
set -euo pipefail

# Staged files Biome can handle (added/copied/modified — not deletions).
# NUL-delimited so filenames with spaces survive the trip through xargs.
# `biome check` respects biome.json includes/excludes, so files outside the
# linted set (packs/next-react/files, .sandcastle) are skipped automatically.
git diff --cached --name-only -z --diff-filter=ACM \
	-- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.json' |
	xargs -0 -r npx --no-install biome check --no-errors-on-unmatched --files-ignore-unknown=true
