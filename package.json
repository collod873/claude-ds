{
  "name": "claude-ds",
  "version": "1.6.1",
  "type": "module",
  "bin": {
    "claude-ds": "dist/cli.js"
  },
  "files": [
    "dist/",
    "packs/next-react/files/",
    "packs/next-react/manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p . && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "commander": "^12.0.0",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^20.11.0",
    "@types/picomatch": "^4.0.3",
    "jsdom": "^24.1.3",
    "tsx": "^4.7.0",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
