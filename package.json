{
  "name": "claude-ds",
  "version": "1.1.0",
  "type": "module",
  "bin": {
    "claude-ds": "dist/cli.js"
  },
  "files": [
    "dist/",
    "packs/next-react/files/",
    "packs/next-react/manifest.json",
    "packs/next-react/MIGRATIONS.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p . && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandcastle": "npx tsx .sandcastle/main.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "picomatch": "^4.0.4",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.6.5",
    "@types/node": "^20.11.0",
    "@types/picomatch": "^4.0.3",
    "jsdom": "^24.1.3",
    "tsx": "^4.7.0",
    "vitest": "^1.5.0",
    "zod": "^4.4.3"
  }
}
