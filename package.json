{
  "name": "claude-ds",
  "version": "1.7.2",
  "description": "Design-system governance scaffold CLI — installs a consistent design-system layout, Claude Code hooks, and contracts into consumer projects, then keeps them in sync across releases.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collod873/claude-ds.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "bin": {
    "claude-ds": "dist/cli.js"
  },
  "files": [
    "dist/",
    "packs/next-react/files/",
    "packs/next-react/manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p . && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.tests.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "npm run build && node scripts/install-hooks.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:fast": "vitest run tests/unit",
    "test:watch": "vitest",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "commander": "^12.0.0",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7.0",
    "@biomejs/biome": "2.4.8",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^20.11.0",
    "@types/picomatch": "^4.0.3",
    "jsdom": "^24.1.3",
    "tsx": "^4.7.0",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
